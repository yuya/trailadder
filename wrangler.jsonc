{
  // Cloudflare Workers Builds deploys this repository: static files from the repository root, and worker.js only
  // for the top page (/), where it adds link previews for ?f=<film>. The name must match the Worker in the dashboard.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trailadder",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/"] },
  // wrangler preview（stg などのブランチ用の確認環境）に必要。プレビュー専用の設定はないので空。assets などは上の設定をそのまま使う
  "previews": {}
}
